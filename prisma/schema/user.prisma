model User {
    id           String     @id @default(cuid())
    name         String
    email        String     @unique
    passwordHash String
    role         Role       @default(CUSTOMER)
    status       UserStatus @default(ACTIVE)
    phone        String?
    address      String?
    avatarUrl    String?

    shopName    String?
    shopAddress String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    gearItems      GearItem[]    @relation("ProviderGear")
    customerOrders RentalOrder[] @relation("CustomerOrders")
    providerOrders RentalOrder[] @relation("ProviderOrders")
    payments       Payment[]
    reviews        Review[]

    @@index([role, status])
    @@map("users")
}
