model User {
    id           String     @id @default(cuid())
    name         String
    email        String     @unique
    password String
    role         Role       @default(CUSTOMER)
    status       UserStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    gearItems      GearItem[]    @relation("ProviderGear")
    customerOrders RentalOrder[] @relation("CustomerOrders")
    providerOrders RentalOrder[] @relation("ProviderOrders")
    payments       Payment[]
    reviews        Review[]

    profile Profile?

    @@index([role, status])
    @@map("users")
}
